# Keep the build context small and exclude local credentials/data by default.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!README.md
!LICENSE
!deceive/
!deceive/**
!hatch_build.py
!skills/
!skills/**
!docs/
!docs/*.md
!examples/
!examples/*.yaml
!examples/profiles/
!examples/profiles/*.yaml
skills/**/.*
skills/**/__pycache__/
skills/**/*.pyc
skills/**/*.key
skills/**/*.pem
skills/**/*_host_key
deceive/**/__pycache__/
deceive/**/*.pyc
deceive/**/*.key
deceive/**/*.pem
deceive/**/*-ssh-key
